{
  "realm": "unihub",
  "enabled": true,
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "user-sync-service",
        "roles": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm",
          "realm-admin"
        ]
      }
    ]
  },
  "scopeMappings": [
    {
      "clientScope": "offline_access",
      "roles": [
        "offline_access"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "STUDENT",
        "description": "General student access"
      },
      {
        "name": "ORGANIZER",
        "description": "Workshop organizers"
      },
      {
        "name": "STAFF",
        "description": "Event and check-in staff"
      },
      {
        "name": "CHECKIN_STAFF",
        "description": "Mobile check-in staff"
      }
    ]
  },
  "clients": [
    {
      "clientId": "unihub-client",
      "name": "Web and Mobile Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://10.0.2.2/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://10.0.2.2",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "realm roles mapping",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "studentId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "studentId",
            "claim.name": "studentId",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "user-sync-service",
      "name": "User Management Admin App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "super-secure-sync-secret-123",
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-user-sync-service",
      "enabled": true,
      "serviceAccountClientId": "user-sync-service",
      "clientRoles": {
        "realm-management": [
          "realm-admin",
          "manage-users",
          "view-users",
          "query-users",
          "assign-roles",
          "view-realm"
        ]
      }
    },
    {
      "username": "organizer",
      "enabled": true,
      "email": "organizer@example.com",
      "firstName": "Organizer",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ORGANIZER"
      ]
    },
    {
      "username": "staff",
      "enabled": true,
      "email": "staff@example.com",
      "firstName": "Check-in",
      "lastName": "Staff",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "STAFF",
        "CHECKIN_STAFF"
      ]
    }
  ]
}
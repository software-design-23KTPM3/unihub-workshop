{
  "realm": "unihub",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "STUDENT",
        "description": "General student access"
      },
      {
        "name": "ORGANIZER",
        "description": "Workshop organizers"
      },
      {
        "name": "STAFF",
        "description": "Event and check-in staff"
      }
    ]
  },
  "clients": [
    {
      "clientId": "unihub-client",
      "name": "Web and Mobile Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "user-sync-service",
      "name": "User Management Admin App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "super-secure-sync-secret-123",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "student_test",
      "enabled": true,
      "email": "student@test.com",
      "firstName": "Student",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "STUDENT"
      ]
    },
    {
      "username": "organizer_test",
      "enabled": true,
      "email": "organizer@test.com",
      "firstName": "Organizer",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ORGANIZER"
      ]
    }
  ]
}
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "STUDENT"
      ]
    },
    {
      "username": "organizer_test",
      "enabled": true,
      "email": "organizer@test.com",
      "firstName": "Organizer",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ORGANIZER"
      ]
